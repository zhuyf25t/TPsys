VITE_AUTH_API_BASE=/api
VITE_BATTLE_API_BASE=/api
VITE_REPLAY_API_BASE=/api
VITE_MAILS_API_BASE=/api
VITE_SOCIAL_API_BASE=/api

# Backend runtime defaults to memory storage.
# Generic DATABASE_URL is intentionally ignored by the rebuilt backend.
# SLAY_DEMO_STORAGE_MODE=memory

# Backend Postgres runtime example:
# SLAY_DEMO_STORAGE_MODE=postgres
# SLAY_DEMO_DATABASE_URL=jdbc:postgresql://localhost:5432/slay_demo
# SLAY_DEMO_DATABASE_USER=slay_user
# SLAY_DEMO_DATABASE_PASSWORD=secret
# SLAY_DEMO_BACKEND_PORT=8080
